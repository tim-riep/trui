{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "aliases.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "tests/**/*.ts",
    "packages/trui/vite.config.ts",
