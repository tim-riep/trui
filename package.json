{
  "name": "trui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm -w @tim-riep/trui run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/trui/tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "biome check . && stylelint --allow-empty-input \"packages/*/src/**/*.css\"",
    "format": "biome format --write .",
    "check:headers": "node scripts/check-headers.mjs",
    "check:terms": "node scripts/check-terms.mjs --all",
    "check:structure": "node scripts/check-structure.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:headers && npm run check:terms && npm run check:structure && npm run check:api",
    "catalog": "storybook dev -p 6006",
    "catalog:build": "storybook build -o dist/catalog && npm run docs:api",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:api": "npm run build && npm -w @tim-riep/trui run api",
    "api:update": "npm run build && npm -w @tim-riep/trui run api:update",
    "docs:api": "npm -w @tim-riep/trui run docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@microsoft/api-extractor": "7.60.1",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "storybook": "10.6.6",
    "stylelint": "18.0.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
