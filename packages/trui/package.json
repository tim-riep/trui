{
  "name": "@tim-riep/trui",
  "version": "0.1.0",
  "description": "React components for business applications",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/set/*.d.ts",
      "import": "./dist/icons/set/*.js"
    },
    "./styles.css": "./dist/trui.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.build.json && node ../../scripts/build-css.mjs",
    "api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "docs": "typedoc",
    "build:browser": "NODE_ENV=production vite build -c vite.browser.config.ts && node ../../scripts/build-css.mjs --out dist-browser --hash"
  }
}
