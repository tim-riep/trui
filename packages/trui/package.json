{
  "name": "@tim-riep/trui",
  "version": "0.1.0",
  "description": "React components for business applications",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": "./dist/trui.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "api": "api-extractor run",
    "api:update": "api-extractor run --local",
    "docs": "typedoc"
  }
}
